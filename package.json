{
  "name": "pi-server",
  "version": "2.0.0",
  "description": "Raspberry Pi machine controller for FastCub Store: runs machines offline, tracks online runs, keeps records for Firestore sync",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dashboard": "node src/dashboard.js",
    "install-autostart": "bash scripts/install-autostart.sh",
    "uninstall-autostart": "bash scripts/uninstall-autostart.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
