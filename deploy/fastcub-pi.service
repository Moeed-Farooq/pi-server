[Unit]
Description=FastCub Pi machine server
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ src/server.js
Restart=always
RestartSec=3
TimeoutStopSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
